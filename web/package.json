{
  "name": "sessiondock-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^24.0.0" },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json",
