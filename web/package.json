{
  "name": "sessiondock-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite build --config vite.migration.config.ts --watch",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json",
    "build": "npm run build:migration",
    "build:legacy": "npm run typecheck && vite build --config vite.legacy.config.ts",
    "build:migration": "npm run typecheck && vite build --config vite.migration.config.ts"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
