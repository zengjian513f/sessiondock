[Unit]
Description=Shared read-only session resource collector
After=local-fs.target sys-fs-resctrl.mount resource-agent-pss.service
Wants=sys-fs-resctrl.mount resource-agent-pss.service

[Service]
Type=simple
EnvironmentFile=/etc/resource-agent.env
ExecStart=/opt/resource-agent/bin/resource-agent --uid ${MONITOR_UID} --node-id-file ${NODE_ID_FILE} --io-events off --memory-bandwidth on
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
RuntimeDirectory=resource-agent
RuntimeDirectoryMode=0755
StateDirectory=resource-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectControlGroups=yes
Delegate=cpu
Environment=RESOURCE_AGENT_SLOW_CPU_BUDGET=1
Environment=RESOURCE_AGENT_PSS_SOCKET=/run/resource-agent-pss/worker.sock
ReadWritePaths=/sys/fs/cgroup/system.slice/%n
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN
ReadWritePaths=/run/resource-agent /var/lib/resource-agent -/sys/fs/resctrl
TasksMax=124
# Connection evidence is retained by age; do not use OOM restarts as eviction.
MemoryMax=infinity
# Main service 80% + PSS service 20% = the previous one-core budget.
# Fast sampler 50%, MBM/GPU 20%, leaving main-service headroom for requests.
CPUQuota=80%
CPUWeight=10
Nice=10

[Install]
WantedBy=multi-user.target
